<Window x:Class="SzigetWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SzigetWPF"
        mc:Ignorable="d"
        Title="Sziget Fesztivál 2025" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Label Content="Műfaj:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbMufaj"  VerticalAlignment="Center" Width="150" SelectionChanged="cmbMufaj_SelectionChanged"/>
            <ProgressBar x:Name="pbHallgatottsag" VerticalAlignment="Center" Width="150" Height="25" Margin="10"/>
            <Button x:Name="btnMentes" Content="Mentes" VerticalAlignment="Center" Click="btnMentes_Click"/>
        </StackPanel>
        <DataGrid x:Name="dtgAdatok" Grid.Row="1" SelectionChanged="dtgAdatok_SelectionChanged"/>
    </Grid>
</Window>
